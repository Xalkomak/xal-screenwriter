{
    "id": "screenplay",
    "name": "Screenplay",
    "version": 1,

    "presentation": {
        "page": {
            "size": "A4",
            "width": 210,
            "height": 297,
            "unit": "mm"
        },

        "margins": {
            "top": 25,
            "bottom": 25,
            "left": 25,
            "right": 25,
            "unit": "mm"
        },

        "alignment": {
            "horizontal": "left",
            "vertical": "center"
        },

        "indentation": {
            "left": 0,
            "right": 0,
            "unit": "mm"
        }
    },

    "elements": [
        {
            "name": "scene_heading",

            "recognition": {
                "prefixes": [
                    "EXT.",
                    "INT.",
                    "#"
                ]
            },

            "constraints": {
                "case": "uppercase"
            }
        },

        {
            "name": "action",

            "recognition": {
                "default": true,
                "prefix": "!"
            },

            "constraints": {
                "uppercase_first_word_requires_prefix": "!"
            }
        },

        {
            "name": "character",

            "constraints": {
                "case": "uppercase"
            },

            "presentation": {
                "alignment": {
                    "horizontal": "center"
                }
            }
        },

        {
            "name": "parenthetical",

            "allowed_after": [
                "character"
            ],

            "presentation": {
                "alignment": {
                    "horizontal": "center"
                }
            }
        },

        {
            "name": "dialogue",

            "allowed_after": [
                "character",
                "parenthetical"
            ],

            "presentation": {
                "alignment": {
                    "horizontal": "center"
                }
            }
        }
    ]
}